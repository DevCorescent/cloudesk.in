# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection string
DATABASE_URL=postgres://USER@localhost:5432/creation_cloud_dev
# Used only by `npm test`
TEST_DATABASE_URL=postgres://USER@localhost:5432/creation_cloud_test

# Public origin of the app; mutating API requests must come from this origin.
APP_URL=http://localhost:3000

# 32-byte key, base64. Encrypts stored provider credentials (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Optional platform-level AI provider keys. Organizations can also add their own
# keys under Settings → AI providers. Without any key, only the built-in
# deterministic planner is available (no LLM features).
ANTHROPIC_API_KEY=
# Optional: semantic search for the site chatbot (Voyage AI embeddings). Without it, search is keyword + typo-tolerant.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
OPENAI_API_KEY=
# Used only by `npm run test:e2e` (wiped on every run)
E2E_DATABASE_URL=postgres://USER@localhost:5432/creation_cloud_e2e

# Optional email delivery through Resend (https://resend.com). Without both,
# emails are only recorded in the outbox (Settings → Developer).
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. orders@yourdomain.com
MAIL_FROM=

# Custom domains: where customers point their domain (one of these), and an
# edge proxy that issues TLS certificates, e.g. Caddy with
#   on_demand_tls { ask http://localhost:3000/api/v1/domains/ask }
CUSTOM_DOMAIN_CNAME=
CUSTOM_DOMAIN_IPV4=

# Hourly growth checks and 10-minute booking reminders run inside the app
# process. Set to "off" on extra instances so they run only once.
GROWTH_SCHEDULER=
BOOKING_SCHEDULER=

# Sign in with GitHub (optional). Create an OAuth app at https://github.com/settings/developers
# with the callback URL <APP_URL>/api/v1/auth/github/callback. The button is hidden until both are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email delivery. Set MAIL_FROM plus one provider; MAIL_PROVIDER picks one when several are set
# (resend | postmark | sendgrid | smtp | outbox). Without a provider, mail is only recorded.
# MAIL_PROVIDER=
# POSTMARK_SERVER_TOKEN=
# POSTMARK_STREAM=outbound
# SENDGRID_API_KEY=
# SMTP_URL=smtp://user:pass@smtp.example.com:587   (or SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE)
# SMTP_REQUIRE_TLS=true

# Platform billing (optional). Without these, plans are not enforced (self-hosted = unlimited).
# Stripe: create two recurring Prices; webhook endpoint <APP_URL>/api/v1/billing/webhooks/stripe
#   (events: checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
# Razorpay: create two Plans; webhook endpoint <APP_URL>/api/v1/billing/webhooks/razorpay (subscription.* events)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_PRO=
# RAZORPAY_PLAN_BUSINESS=

# Terminal: JavaScript always runs in the built-in QuickJS (WebAssembly) sandbox.
# Python and full Node.js run in throwaway Docker containers only when enabled here
# and the docker CLI can reach a daemon (no network, read-only, 256 MB, 1 CPU, 20 s).
EXEC_DOCKER=off
EXEC_PYTHON_IMAGE=python:3.12-alpine
EXEC_NODE_IMAGE=node:22-alpine

# Where the database (and so every record and file) is hosted, shown to
# workspace owners in Settings → Workspace, e.g. "India — Mumbai (ap-south-1)".
DATA_REGION=
